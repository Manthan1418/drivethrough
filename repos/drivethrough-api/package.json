{
  "name": "drivethrough-api",
  "version": "0.0.1",
  "private": true,
  "description": "DriveThrough backend — Next.js route handlers only (no pages). Owns DB, providers, upload/download engines, cron. Cross-origin bearer-token auth.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
  "test:e2e": "bash -c 'set -a; . ./.env; set +a; E2E_DRIVE=1 vitest run tests/e2e-drive-contract.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@drivethrough/contracts": "*",
    "drizzle-orm": "^0.36.0",
    "jose": "^5.9.0",
    "next": "^15.0.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
