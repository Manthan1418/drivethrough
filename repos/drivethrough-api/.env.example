# drivethrough-api — backend env template. Copy to .env.local (never commit real values).
# These are ALL server-side secrets. None ship to the browser (no NEXT_PUBLIC_ prefix).

# Postgres (Neon / Vercel Postgres via Marketplace)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Firebase — ID-token verification is KEYLESS (Google public JWKS via jose; org policy blocks
# service-account key creation and JWT verification needs no secret). Only the project id is
# used (issuer + audience). firebase-admin is NOT a dependency anymore.
FIREBASE_PROJECT_ID="your-project-id"

# AES-256-GCM key for the token vault (32 bytes, base64). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Google OAuth (connect-a-account flow) — Drive API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# FULL callback URL, registered verbatim in GCP → Authorized redirect URIs (localhost allowed in dev)
GOOGLE_REDIRECT_URI="http://localhost:3001/api/accounts/google/callback"

# CORS — the frontend origin(s), comma-separated. Never wildcard.
CORS_ALLOW_ORIGIN="https://app.example.com,http://localhost:3000"

# Frontend base URL — where the OAuth callback redirects after connect (/settings?connected=1)
FRONTEND_BASE_URL="http://localhost:3000"

# Upload limits
MAX_UPLOAD_BYTES="53687091200"   # 50 GB default (tech.md §6)
CHUNK_SIZE="4194304"             # 4 MB (may grow to 16-32MB if Worker relay adopted — prd §11)

# Optional
RECAPTCHA_SECRET_KEY=""
