# drivethrough-app — frontend env template (placeholders only; this file is committed).
# Copy real values into `.env` (gitignored) — local dev runs app on :3000, api on :3001.

# Firebase web config — PUBLIC by design (Firebase console → Project settings → Add web app).
# Security comes from server-side token verification in drivethrough-api, not from hiding these.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Backend API base URL (all calls go through client/api.ts).
# Local dev: http://localhost:3001   |   Deployed: https://<api-project>.vercel.app
NEXT_PUBLIC_API_URL="http://localhost:3001"
